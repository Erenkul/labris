  "item": [
    {
      "name": "Görev Update",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Gorev basariyla guncellenmeli (200 donmeli)\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Icerik gercekten guncellenmis olmali\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    pm.expect(jsonData.content).to.eql(\"Guncellenmis test gorevi\");\r",
              "});\r",
              "\r",
              "pm.test(\"Oncelik gercekten guncellenmis olmali\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    pm.expect(jsonData.priority).to.eql(4);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "YOUR_TODOIST_TOKEN_HERE",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"content\": \"Guncellenmis test gorevi\",\r\n  \"priority\": 4\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "https://api.todoist.com/api/v1/tasks/{{gorev_id}}",
          "protocol": "https",
          "host": [
            "api",
            "todoist",
            "com"
          ],
          "path": [
            "api",
            "v1",
            "tasks",
            "{{gorev_id}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Görev Oluştur-Başarılı",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Durum kodu 200 olmali\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Cevapta gorev ID'si olmali\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    pm.expect(jsonData).to.have.property(\"id\");\r",
              "});\r",
              "\r",
              "pm.test(\"Gorev icerigi dogru olmali\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    pm.expect(jsonData.content).to.eql(\"Test görevi - Postman\");\r",
              "});\r",
              "const jsonData = pm.response.json();\r",
              "pm.environment.set(\"gorev_id\", jsonData.id);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
